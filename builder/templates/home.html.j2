<p class="muted">Snapshot generated {{ generated }}.</p>

<script id="activity-data" type="application/json">{{ activity_data }}</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/plotly.js/3.0.1/plotly-basic.min.js"
        integrity="{{ plotly_sri }}" crossorigin="anonymous" referrerpolicy="no-referrer"
        defer></script>
<script>
window.addEventListener("load", function () {
  if (typeof Plotly === "undefined") return;  // the static SVG stays up
  var d = JSON.parse(document.getElementById("activity-data").textContent);

  // Swap before plotting, never after. Plotly measures the container at
  // newPlot, and a `hidden` div measures nothing, so it fell back to its
  // built-in 700px and only snapped to the real width on the next resize.
  var plot = document.getElementById("activity-plot");
  document.getElementById("activity-static").hidden = true;
  document.getElementById("activity-key").hidden = true;  // Plotly draws its own
  plot.hidden = false;

  var css = getComputedStyle(document.documentElement);
  var theme = document.documentElement.getAttribute("data-theme");
  var dark = theme ? theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;

  var ink = css.getPropertyValue("--fg").trim();
  var dim = css.getPropertyValue("--fg-dim").trim();
  var line = css.getPropertyValue("--line").trim();
  var blue = dark ? "#3987e5" : "#2a78d6";
  var orange = dark ? "#d95926" : "#eb6834";

  function bar(y, name, color, axis, show) {
    return {
      type: "bar", x: d.years, y: y, name: name,
      marker: { color: color, line: { width: 0 } },
      xaxis: axis === 2 ? "x2" : "x", yaxis: axis === 2 ? "y2" : "y",
      showlegend: show === true,
      hovertemplate: "<b>%{y:,}</b> " + name.toLowerCase() + "<extra></extra>"
    };
  }

  var ax = { gridcolor: line, zerolinecolor: line, linecolor: line,
             tickfont: { color: dim, size: 11 }, automargin: true,
             showspikes: false, fixedrange: false };

  Plotly.newPlot(plot, [
    bar(d.issues, "Issues", blue, 1, true),
    bar(d.merge_requests, "Merge requests", orange, 1, true),
    bar(d.comments, "Comments", blue, 2, false)
  ], {
    barmode: "stack",
    bargap: 0.25,
    grid: { rows: 2, columns: 1, pattern: "independent", roworder: "top to bottom",
            ygap: 0.22 },
    height: 380,
    autosize: true,
    margin: { l: 56, r: 12, t: 30, b: 34 },
    paper_bgcolor: "rgba(0,0,0,0)",
    plot_bgcolor: "rgba(0,0,0,0)",
    font: { family: css.getPropertyValue("--sans").trim(), color: ink, size: 12 },
    hovermode: "x unified",
    hoverlabel: { bgcolor: css.getPropertyValue("--bg").trim(), bordercolor: line,
                  font: { color: ink, size: 12 } },
    legend: { orientation: "h", y: 1.1, x: 0, font: { color: dim },
              bgcolor: "rgba(0,0,0,0)" },
    xaxis: Object.assign({}, ax, { type: "category", showticklabels: false, showgrid: false }),
    xaxis2: Object.assign({}, ax, { type: "category", showgrid: false }),
    yaxis: Object.assign({}, ax, {
      title: { text: "Opened", font: { color: dim, size: 11 }, standoff: 12 },
      tickformat: "~s" }),
    yaxis2: Object.assign({}, ax, {
      title: { text: "Comments", font: { color: dim, size: 11 }, standoff: 12 },
      tickformat: "~s" })
  }, {
    displayModeBar: "hover",
    modeBarButtonsToRemove: ["select2d", "lasso2d", "autoScale2d", "toggleSpikelines"],
    displaylogo: false,
    responsive: true
  });
});
</script>
